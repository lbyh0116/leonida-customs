; Engine configuration
config_version=5

[application]
config/name="GTA VI 载具预览器"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1360
window/size/viewport_height=820
window/size/min_width=900
window/size/min_height=595
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
streamline/dlss_preset="M"
anti_aliasing/quality/msaa_3d=1
textures/default_filters/anisotropic_filtering_level=3
