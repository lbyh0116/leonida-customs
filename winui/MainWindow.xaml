<Window x:Class="VehicleStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Shell" UseLayoutRounding="True"
          Loaded="ShellLoaded" Padding="15" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="SolidBackdrop" Grid.RowSpan="3" Margin="-15" Visibility="Collapsed"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsHitTestVisible="False" />

        <Grid ColumnSpacing="13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="52" Height="52" Source="ms-appx:///Assets/leonida-mark.png"
                   AutomationProperties.Name="Leonida Motorworks" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Leonida Motorworks · 载具预览器" FontSize="23" FontWeight="SemiBold" />
                <TextBlock x:Name="SourceSummary" Text="等待连接本地游戏目录" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="OpenFolder" Click="OpenFolderClicked" Content="打开游戏目录" />
                <Button x:Name="SettingsButton" Click="ToggleSettings" Content="设置" />
            </StackPanel>
        </Grid>

        <Grid x:Name="StudioPage" Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="285" />
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="9" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12">
                <Grid RowSpacing="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="载具库" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="VehicleCount" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0" />
                    </Grid>
                    <TextBox Grid.Row="1" x:Name="Search" PlaceholderText="搜索车型、厂牌或 ID" TextChanged="SearchChanged" />
                    <ComboBox Grid.Row="2" x:Name="Category" HorizontalAlignment="Stretch"
                              SelectionChanged="FilterChanged" AutomationProperties.Name="载具类别" />
                    <ListView Grid.Row="3" x:Name="VehicleList" SelectionMode="Single" SelectionChanged="VehicleSelected">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="4" x:Name="CatalogNote" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="9"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="15,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ViewTitle" Text="白色摄影棚" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ViewSubtitle" Text="选择载具即可预览" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="GpuTime" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"
                                   ToolTipService.ToolTip="视口实际输出像素与 3D GPU 耗时" />
                    </Grid>
                    <Grid Grid.Row="1" x:Name="PreviewSurface" Margin="1,0" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Image x:Name="PreviewImage" Stretch="Uniform" IsHitTestVisible="False" />
                        <ProgressBar x:Name="PreviewProgress" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed"
                                     AutomationProperties.Name="正在准备路径追踪画面" IsHitTestVisible="False" />
                    </Grid>
                    <Grid Grid.Row="2" Padding="10,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="5" x:Name="CameraToolbar">
                            <Button Content="重置" Click="ResetCamera" ToolTipService.ToolTip="重置视角" />
                            <ToggleButton x:Name="Rotate" Content="旋转" Click="ToggleCamera" Tag="rotate" />
                            <ToggleButton x:Name="Fly" Content="自由视角" Click="ToggleCamera" Tag="free" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="CameraHint" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="拖动旋转 · 右键平移 · 滚轮缩放" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="9" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10">
                <Grid x:Name="VehicleOptions" RowSpacing="10" Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollMode="Disabled">
                        <StackPanel Spacing="9" Padding="4,0,5,0">
                            <TextBlock Text="原厂配置" FontWeight="SemiBold" />
                            <ComboBox x:Name="Factory" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="原厂配置" />
                            <ComboBox x:Name="PaintFinish" Header="车漆预览" HorizontalAlignment="Stretch"
                                      SelectedIndex="0" IsEnabled="False">
                                <x:String>原厂漆面</x:String>
                                <x:String>亮光实色</x:String>
                                <x:String>金属漆</x:String>
                                <x:String>哑光</x:String>
                                <x:String>珠光</x:String>
                            </ComboBox>
                            <TextBox x:Name="PaintColor" Header="自定义漆色" PlaceholderText="原车颜色或 #RRGGBB"
                                     MaxLength="7" IsEnabled="False" />
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="改装配件" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="ReadParts" Content="读取配件" HorizontalAlignment="Right" Click="ReadPartsClicked" />
                            </Grid>
                            <TextBlock x:Name="PartsNote" Text="选择载具后可查看可用配件。" FontSize="12"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="PartsPanel" Spacing="9" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Spacing="6" Padding="3,0">
                        <Button x:Name="Apply" Content="更新预览" Click="ApplyClicked"
                                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CopyCode" Content="复制改车码" HorizontalAlignment="Stretch" Click="CopyClicked" />
                            <Button x:Name="ImportCode" Grid.Column="1" Content="导入改车码" HorizontalAlignment="Stretch" Click="ImportClicked" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" HorizontalScrollMode="Disabled">
            <Grid ColumnSpacing="16" RowSpacing="14" Padding="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="设置" Grid.ColumnSpan="3" FontSize="28" FontWeight="SemiBold" Margin="2,7,0,0" />
                <Border Grid.Row="1" Padding="15" CornerRadius="9" VerticalAlignment="Top"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="外观与预览" FontSize="17" FontWeight="SemiBold" />
                        <ComboBox x:Name="ThemeChoice" Header="界面主题" HorizontalAlignment="Stretch" SelectionChanged="AppearanceChanged">
                            <x:String>跟随系统</x:String>
                            <x:String>浅色</x:String>
                            <x:String>深色</x:String>
                        </ComboBox>
                        <ToggleSwitch x:Name="MicaSwitch" Header="云母背景（Mica）" Toggled="AppearanceChanged" />
                        <ToggleSwitch x:Name="LampSwitch" Header="车灯" Toggled="PreviewPreferenceChanged" />
                        <ToggleSwitch x:Name="GridLines" Header="地面网格" Toggled="PreviewPreferenceChanged" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="15" CornerRadius="9" VerticalAlignment="Top"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel x:Name="RenderPanel" Spacing="9">
                        <TextBlock Text="渲染" FontSize="17" FontWeight="SemiBold" />
                        <ComboBox x:Name="RenderMode" Header="渲染模式" HorizontalAlignment="Stretch" SelectionChanged="RenderModeChanged">
                            <ComboBoxItem Content="纯光栅 · Forward+" />
                            <ComboBoxItem x:Name="PathTracingOption" Content="全路径追踪 · RTX" />
                        </ComboBox>
                        <ComboBox x:Name="PathQuality" Header="路径追踪画质" HorizontalAlignment="Stretch" SelectionChanged="QualityChanged">
                            <x:String>性能 · 1 样本/像素</x:String>
                            <x:String>平衡 · 2 样本/像素</x:String>
                            <x:String>质量 · 4 样本/像素</x:String>
                            <x:String>极致 · 8 样本/像素</x:String>
                        </ComboBox>
                        <ComboBox x:Name="Antialias" Header="抗锯齿与超分方法" HorizontalAlignment="Stretch"
                                  SelectionChanged="AaMethodChanged" />
                        <ComboBox x:Name="AaQuality" Header="抗锯齿与超分档位" HorizontalAlignment="Stretch"
                                  SelectionChanged="AaQualityChanged" />
                        <TextBlock x:Name="RayStatus" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox x:Name="Ssr" Content="反射 · SSR 与地板倒影" Click="QualityChanged" />
                        <CheckBox x:Name="Ao" Content="环境光遮蔽 SSAO" Click="QualityChanged" />
                        <CheckBox x:Name="Ssil" Content="间接光照 SSIL" Click="QualityChanged" />
                        <CheckBox x:Name="Bloom" Content="高光辉光" Click="QualityChanged" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Padding="15" CornerRadius="9" VerticalAlignment="Top"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="9">
                        <TextBlock Text="灯光与地面" FontSize="17" FontWeight="SemiBold" />
                        <Button x:Name="FloorColorButton" Content="地面颜色" HorizontalAlignment="Stretch">
                            <Button.Flyout>
                                <Flyout Placement="Left">
                                    <ColorPicker x:Name="FloorPicker" IsAlphaEnabled="False"
                                                 IsColorPreviewVisible="True" ColorChanged="FloorColorChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <StackPanel x:Name="LightingPanel" Spacing="6" />
                        <Button Content="重置灯光与地面" Click="ResetLighting" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" Text="正在启动渲染器…" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
            <ProgressBar x:Name="Progress" Grid.Column="1" Width="150" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="MeshDetails" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
        </Grid>
    </Grid>
</Window>
